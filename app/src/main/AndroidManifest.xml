<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Launcher entry: window list (Attached/Detached state) -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- wayland windows are hosted by com.anlandnext.awl.AwlWindowActivity,
             merged in from the libawl library module (same code third-party
             consumer apps run) -->

        <!-- Window behavior settings -->
        <activity android:name=".WlSettingsActivity" android:exported="false"/>

        <!-- client closed its own window → daemon notification finishes the Activity -->
        <receiver android:name=".WindowGoneReceiver" android:exported="true">
            <intent-filter>
                <action android:name="anland.WINDOW_GONE"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
