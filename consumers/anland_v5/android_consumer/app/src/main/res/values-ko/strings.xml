    <!-- Touchpad -->
    <string name="touchpad_mode_switch">터치패드 모드 (상대 좌표 이동)</string>
    <string name="touchpad_hint">켜짐: 손가락을 움직이면 마우스 커서가 이동합니다 (상대 좌표). 꺼짐: 터치한 위치가 화면 좌표에 그대로 대응됩니다 (절대 좌표).</string>
    <string name="pointer_capture_switch">외부 포인터 캡처</string>
    <string name="pointer_capture_hint">외부 마우스나 터치패드를 데스크톱 화면에 고정하고 상대 좌표 이동을 사용하므로, 화면 상단이나 하단 가장자리에 닿아도 안드로이드 시스템 바가 나타나지 않습니다. 뒤로가기를 눌러 일시적으로 해제할 수 있으며, 데스크톱 화면을 클릭하면 다시 캡처됩니다. 화면 터치 입력에는 영향을 주지 않습니다.</string>
    <string name="pointer_capture_released">외부 포인터가 해제되었습니다. 데스크톱 화면을 클릭하면 다시 캡처됩니다.</string>
    <string name="mouse_sensitivity_label">터치패드 포인터 감도 (가속)</string>
    <string name="mouse_accel_value">%1$.1fx</string>
    <string name="scroll_reverse_switch">스크롤 방향 반전</string>
    <string name="scroll_reverse_hint">켜짐: 콘텐츠가 손가락을 따라 움직입니다("자연스러운" 스크롤). 화면과 실제 터치패드의 두 손가락 스크롤 모두에 적용됩니다.</string>
    <string name="scroll_speed_label">두 손가락 스크롤 속도</string>
    <string name="scroll_speed_value">%1$.2f</string>
    <string name="threshold_factor_value">터치 슬롭의 %1$.2f배</string>
    <string name="scroll_threshold_label">스크롤 감지 임계값</string>
    <string name="scroll_threshold_hint">손가락이 얼마나 움직여야 스크롤로 인식할지 설정합니다. 핀치 동작이 스크롤로 잘못 인식된다면 이 값을 낮추세요.</string>
    <string name="move_threshold_label">제스처 확정 임계값</string>
    <string name="move_threshold_hint">모호한 두 손가락 제스처를 판별하기까지 선행 손가락이 이동해야 하는 거리입니다. 스크롤이 느리게 시작된다면 이 값을 낮추세요.</string>
    <string name="gesture_scale_label">제스처 크기</string>
    <string name="gesture_scale_value">%1$.0f px</string>
    <string name="gesture_scale_hint">터치로 전달되는 제스처(핀치, 세 손가락 이상)는 포인터를 중심으로 이 크기의 정사각형 영역에 매핑됩니다. 값이 클수록 같은 손가락 움직임이 더 멀리 이동합니다.</string>
    <string name="disable_multi_finger_switch">핀치 및 다중 손가락 제스처 비활성화</string>
    <string name="disable_multi_finger_hint">켜짐: 두 손가락 핀치/확대축소 및 세 손가락 이상의 제스처가 무시되어 데스크톱에 전달되지 않습니다. 두 손가락 스크롤과 두 손가락 우클릭은 계속 작동합니다. 꺼짐: 핀치 및 다중 손가락 제스처가 터치로 데스크톱에 전달됩니다.</string>
    <!-- Connection -->
    <string name="socket_path_label">데몬 소켓 경로</string>
    <string name="second_window_label">두 번째 창 열기 (별도 데몬 및 제목)</string>
    <string name="second_window_name_hint">창 이름 (예: work)</string>
    <string name="second_window_open">두 번째 창 열기</string>
    <string name="root_switch">루트로 연결 (헬퍼)</string>
    <string name="root_hint">소켓에 연결하여 연결을 앱으로 전달하는 루트 헬퍼(su)를 실행합니다. 다음 연결 시(앱을 다시 열 때) 적용됩니다.</string>
    <string name="topapp_switch">포그라운드 스케줄링 사용 (root)</string>
    <string name="topapp_hint">Linux 데스크톱에 Android 포그라운드 CPU 우선순위를 부여합니다. 아래에서 범위를 선택하며 다음 연결부터 적용됩니다.</string>
    <string name="topapp_mode_label">포그라운드 스케줄링 범위</string>
    <string-array name="topapp_mode_options">
        <item>1 - 포커스된 앱</item>
        <item>2 - 전체 데스크톱 세션</item>
    </string-array>
    <string name="topapp_mode_focused_hint">모드 1: KWin과 활성 앱 scope를 top-app에 유지합니다. 해당 scope의 기존 프로세스와 자식 프로세스가 포함되며 포커스가 바뀌면 이전 앱을 복원합니다.</string>
    <string name="topapp_mode_whole_hint">모드 2: 연결이 끝날 때까지 전체 Anland 데스크톱 프로세스 트리를 top-app으로 이동합니다. 백그라운드 앱과 서비스도 향상되어 전력 사용은 늘지만 세션 우선순위는 최대가 됩니다.</string>
    <string name="topapp_stops_label">스캔 정지 프로세스 이름 (선택 사항)</string>
    <string name="topapp_stops_hint">예: systemd:init (":"로 구분); 비워두면 기본 목록 사용</string>
    <string name="mic_switch">마이크를 데스크톱으로 전달</string>
    <string name="mic_hint">데스크톱 오디오는 항상 이 기기의 스피커로 재생됩니다. 이 옵션을 켜면 마이크도 반대 방향으로 전송됩니다. 다음 연결 시(앱을 다시 열 때) 적용됩니다.</string>
    <string name="camera_switch">카메라를 데스크톱으로 전달</string>
    <string name="camera_hint">데스크톱에서 이 기기의 카메라를 영상 소스로 열 수 있게 합니다. 카메라는 데스크톱이 실제로 녹화 중일 때만 켜집니다. 앱으로 다음에 돌아올 때 적용되며, 처음 사용 시 카메라 권한을 요청합니다.</string>
    <string name="audio_keepalive_switch">오디오 유지 활성화</string>
    <string name="audio_keepalive_hint">오디오 출력 스트림을 계속 실행하여 짧은 리눅스 소리(볼륨 조절음, 키 클릭음)가 항상 즉시 재생되도록 합니다. 대기 전력을 약간 더 소모합니다. 꺼짐: 데스크톱이 약 1.5초간 무음이면 오디오 경로가 절전 상태로 전환되고 다음 소리 재생 시 깨어납니다. 재생 지연이 원하는 대로 맞지 않는다면 아래의 오디오 지연시간 프리셋을 조정하세요.</string>
    <string name="audio_latency_title">오디오 지연시간</string>
