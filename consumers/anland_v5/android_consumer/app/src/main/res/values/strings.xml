    <!-- Immersive input sources -->
    <string name="cat_immersive_title">Immersive Mode</string>
    <string name="cat_immersive_subtitle">Full-screen input control, the toggle key and the input source</string>
    <string name="immersive_inputs_title">Immersive input</string>
    <string name="immersive_inputs_subtitle">Choose where immersive mode takes its input from</string>
    <string name="section_immersive_inputs_source">Input source</string>
    <string name="section_immersive_inputs_direct">Event nodes to take</string>
    <string name="section_immersive_inputs_scope">What this covers</string>

    <string name="immersive_inputs_direct_blurb">Currently: Anland takes the physical event nodes itself, and Android cannot see them while it does. Requires root.</string>
    <string name="immersive_inputs_bus_hint">Gold remaps the keyboard; Anland takes its output exclusively and sends it directly to the desktop.</string>
    <string name="immersive_inputs_combined_hint">Anland takes touch, pointers and gamepads together with Gold\'s remapped keyboard output.</string>
    <string name="immersive_inputs_bus_scope">Requires root and the Gold Keyboard Remaps module. All remapped keyboard keys, including Meta and system shortcuts, go to the desktop during the session. Touch, mouse and Android gestures stay available. Leaving the app or locking the screen releases the keyboard.</string>
    <string name="immersive_inputs_direct_hint">Only the devices ticked below are taken, including gamepads. Devices Gold has confirmed it holds are shown but cannot be selected. Gamepads pause Android input only; the Linux desktop reads them directly through the mounted /dev/input.</string>
    <string name="immersive_inputs_auto">Choose devices automatically</string>
    <string-array name="immersive_source_options">
        <item>Anland takes the devices (direct)</item>
        <item>Gold keyboard directly to desktop</item>
        <item>Direct touch, pointers and gamepads + Gold keyboard</item>
    </string-array>
    <string name="immersive_source_unavailable">Requires the Gold Keyboard Remaps module, which is not installed or not running</string>
    <string name="immersive_auto_enter">Automatically enter immersive mode</string>
    <string name="immersive_auto_enter_hint">Automatically send the Gold keyboard to the desktop when this app returns to the foreground. Touch and Android gestures stay available.</string>
