    <!-- Immersive mode -->
    <string name="section_immersive">Immersive Mode</string>
    <string name="immersive_switch">Enable Immersive Mode</string>
    <string name="immersive_hint">Sends touch, keyboard, mouse and gamepad input directly to the Linux desktop, keeping Android gestures out of the way. Requires root. Set a toggle key below: press it once to enter and again to exit. The mode also ends when you switch apps.</string>
    <string name="immersive_hud_touch_switch">Touch HUD controls in immersive mode</string>
    <string name="immersive_hud_touch_hint">Keeps the on-screen HUD keys, d-pad and touchpad working while the panel is grabbed. Turn it off to send every touch straight to the desktop, leaving the HUD display-only.</string>
    <string name="immersive_oplus_refresh_rate_switch">Keep OnePlus refresh rate fixed</string>
    <string name="immersive_oplus_refresh_rate_hint">Prevents refresh-rate drops on some OnePlus devices when input events are not received.</string>
    <string name="bind_immersive_key_button">Bind Immersive Mode Key</string>
    <string name="immersive_exited">Immersive mode off</string>
    <string name="immersive_no_scancode">Bind a key for immersive mode first</string>
    <string name="immersive_failed">Could not start immersive mode: root was denied or is unavailable</string>
    <string name="immersive_no_devices">Could not start immersive mode: no input device could be taken over</string>
    <string name="immersive_controller_failed">Could not start immersive mode: Android controller suppression failed; input takeover was cancelled</string>
    <string name="immersive_controller_interrupted">Immersive mode ended: Android controller suppression was lost; input takeover was released</string>
    <string name="immersive_interrupted">Immersive mode ended; input returned to Android</string>
    <string name="immersive_entering_mode">Immersive mode on: %1$s</string>

    <string name="immersive_gold_unknown">Could not check which devices Gold holds; starting without keeping any of them free</string>
