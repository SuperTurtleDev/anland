    <!-- Immersive input sources -->
    <string name="cat_immersive_title">沉浸模式</string>
    <string name="cat_immersive_subtitle">全屏输入控制、切换按键与输入来源</string>
    <string name="immersive_inputs_title">沉浸输入</string>
    <string name="immersive_inputs_subtitle">选择沉浸模式从哪里获取输入</string>
    <string name="section_immersive_inputs_source">输入来源</string>
    <string name="section_immersive_inputs_direct">要接管的 event 节点</string>
