    <string name="touchpad_mode_switch">触摸板模式（相对移动）</string>
    <string name="stylus_button_right_click_switch">手写笔侧键作为右键</string>
    <string name="stylus_hover_scroll_switch">悬停时按住手写笔侧键滚动</string>
    <string name="stylus_hover_scroll_hint">按住手写笔侧键并移动悬空的笔尖。滚动量取纵向位移，斜向移动也按其中的纵向分量计算。</string>
    <string name="stylus_hover_scroll_speed_label">手写笔悬停滚动速度</string>
    <string name="touchpad_hint">开启：手指滑动移动鼠标光标（相对）。关闭：触摸直接映射到屏幕（绝对）。</string>
    <string name="pointer_capture_switch">捕获外接指针</string>
    <string name="pointer_capture_hint">开启后将外接鼠标或触摸板锁定在桌面画面内并使用相对移动，移到屏幕顶部或底部不会呼出 Android 状态栏或导航栏。按 Android 返回键可暂时释放，点击桌面画面重新捕获；屏幕触摸不受影响。</string>
    <string name="pointer_capture_released">外接指针已释放。点击桌面画面可重新捕获。</string>
    <string name="mouse_sensitivity_label">触摸板指针灵敏度（加速度）</string>
    <string name="mouse_accel_value">%1$.1f 倍</string>
    <string name="scroll_reverse_switch">反向滚动</string>
    <string name="scroll_reverse_hint">开启后内容跟随手指移动（“自然滚动”）。对屏上触摸板和物理触摸板的双指滚动同时生效。</string>
    <string name="scroll_speed_label">双指滚动速度</string>
    <string name="scroll_speed_value">%1$.2f</string>
    <string name="threshold_factor_value">%1$.2f 倍触摸阈值</string>
    <string name="scroll_threshold_label">滚动判定阈值</string>
    <string name="scroll_threshold_hint">手指移动多远才算“在动”。如果双指开合被当成滚动，调低此值。</string>
    <string name="move_threshold_label">手势定性阈值</string>
    <string name="move_threshold_hint">主导手指移动多远才对双指手势定性。如果滚动起步迟滞，调低此值。</string>
    <string name="gesture_scale_label">手势幅度</string>
    <string name="gesture_scale_value">%1$.0f 像素</string>
    <string name="gesture_scale_hint">转为触摸的手势（双指开合、三指及以上）会映射到以指针为中心、边长为此值的正方形内。值越大，相同的手指移动幅度越大。</string>
    <string name="disable_multi_finger_switch">禁用双指开合与多指手势</string>
    <string name="disable_multi_finger_hint">开启：双指捏合/张开和三指及以上的手势会被吞掉，不会传到桌面；双指滚动和双指右键仍正常。关闭：双指开合、多指手势作为触摸转发到桌面。</string>
    <!-- Connection -->
    <string name="socket_path_label">守护进程套接字路径</string>
    <string name="second_window_label">打开第二个窗口（独立守护进程与标题）</string>
    <string name="second_window_name_hint">窗口名称（如 work）</string>
    <string name="second_window_open">打开第二个窗口</string>
    <string name="root_switch">使用 root 连接（辅助程序）</string>
    <string name="root_hint">启动一个 root 辅助程序（su）连接到套接字，并将连接传回应用。下次连接时生效（请重新打开应用）。</string>
    <string name="topapp_switch">启用前台调度（root）</string>
    <string name="topapp_hint">让 Linux 桌面获得 Android 前台 CPU 优先级。请在下方选择调度范围；下次连接时生效。</string>
    <string name="topapp_mode_label">前台调度范围</string>
    <string-array name="topapp_mode_options">
        <item>1 - 当前焦点应用</item>
        <item>2 - 整个桌面会话</item>
    </string-array>
    <string name="topapp_mode_focused_hint">模式 1：KWin 和当前活动应用的 scope 保持在 top-app。该 scope 中已有的进程及其子进程都会包含；焦点切换时恢复上一个应用。</string>
    <string name="topapp_mode_whole_hint">模式 2：连接期间将整个 Anland 桌面进程树放入 top-app。后台应用和服务也会提升，功耗更高，但整个会话可获得最高调度优先级。</string>
    <string name="topapp_stops_label">扫描结束进程名（可选）</string>
    <string name="topapp_stops_hint">例如 systemd:init（用“:”分隔）；留空使用内置列表</string>
    <string name="mic_switch">将麦克风转发到桌面</string>
    <string name="mic_hint">桌面音频始终通过本设备的扬声器播放。启用此项还会把麦克风反向发送到桌面。下次连接时生效（请重新打开应用）。</string>
    <string name="camera_switch">将摄像头转发到桌面</string>
    <string name="camera_hint">允许桌面将本设备的摄像头作为视频源打开。仅在桌面正在录制时摄像头才会开启。下次返回应用时生效；首次使用会请求摄像头权限。</string>
    <string name="audio_keepalive_switch">音频保活</string>
    <string name="audio_keepalive_hint">保持音频输出流持续活跃，让 Linux 的短促系统音（音量提示、按键音）始终即时播放；会略增待机功耗。关闭时桌面静默约1.5秒后音频通路自动休眠，下次出声时自动唤醒。开启后若听感延迟不合预期，可能需要配合调整下方的「音频延迟」预设。</string>
    <string name="audio_latency_title">音频延迟</string>
