+{
+  ClutterStageViewPrivate *priv =
+    clutter_stage_view_get_instance_private (view);
+
+  g_return_if_fail (framebuffer != NULL);
+  g_return_if_fail (cogl_framebuffer_get_width (priv->framebuffer) ==
