# Build the backend-compatible Hyprland and Aquamarine revisions.
# Keep the complete /usr SDK and runtime layout; only the ABI-patched
# Aquamarine is renamed, so system Aquamarine and its consumers stay intact.
pkgbase=hyprland-anland
pkgname=(hyprland-anland hyprpm-anland)
pkgver=0.57.0
pkgrel=4.1
pkgdesc='Hyprland with Anland v5, Arch Linux ARM runtime and plugin SDK layout'
arch=(aarch64)
url=https://github.com/hyprwm/Hyprland
license=(BSD-3-Clause)
_hyprland_depends=(
    cairo libgcc libstdc++ glibc glib2 libgio-2.0.so libgobject-2.0.so glslang
    hyprcursor libhyprcursor.so hyprgraphics libhyprgraphics.so hyprland-guiutils
    hyprlang libhyprlang.so 'hyprutils>=0.14.3' 'libhyprutils.so=13-64' hyprwire libhyprwire.so
    lcms2 liblcms2.so libcanberra 'libcanberra.so=0-64' libdrm libglvnd libEGL.so
    libGLESv2.so libinput libx11 libxcb
    libxcomposite libxcursor libxfixes 'libxkbcommon>=1.11' libxkbcommon.so libxrender
    'lua>=5.5' 'lua<5.6' mesa muparser opengl-driver pango libpango-1.0.so
    libpangocairo-1.0.so pixman libpixman-1.so re2 libre2.so tomlplusplus
    libtomlplusplus.so util-linux-libs libuuid.so wayland libwayland-server.so
    'wayland-protocols>=1.49' sdbus-cpp 'libsdbus-c++.so=2-64' xcb-proto xcb-util
    xcb-util-errors xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm xorg-xwayland)
# Dependencies for the renamed bundled Aquamarine and explicit Anland launcher.
_anland_depends=(libpipewire libdisplay-info libdisplay-info.so hwdata seatd
    libseat.so systemd-libs libudev.so libei 'libeis.so=1-64' readline 'libreadline.so=8-64'
    procps-ng util-linux bash)
depends=("${_hyprland_depends[@]}" "${_anland_depends[@]}")
makedepends=(cmake 'gcc>=15' glaze hyprland-protocols hyprwayland-scanner meson sdbus-cpp
    ninja xorgproto python git pkgconf patchelf glm cpio)
checkdepends=(doctest)
optdepends=('hyprpm-anland: build and install plugins with the matching SDK'
    'hyprshutdown: clean logout and shutdown helper'
    'xdg-desktop-portal-hyprland: xdg-desktop-portal backend for hyprland'
    'polkit: authentication')
source=(
 'hyprland::git+https://github.com/hyprwm/Hyprland.git#commit=0aa6745f705f2c4b0a5004eb019ef76e5bbdb426'
 'aquamarine::git+https://github.com/hyprwm/aquamarine.git#commit=f31c47a1b9d300847d8fc3108ad959448103dfc1'
 'hyprgrass::git+https://github.com/horriblename/hyprgrass.git#commit=8ca1af717d5b4ea1215a781df52bcef02d7b15e6'
 'wf-touch::git+https://github.com/WayfireWM/wf-touch.git#commit=8974eb0f6a65464b63dd03b842795cb441fb6403'
 'udis86::git+https://github.com/canihavesomecoffee/udis86.git#commit=5336633af70f3917760a6d441ff02d93477b0c86'
 'anland-inputs.tar.gz')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' '@INPUT_SHA256@')
_prefix=/usr

pkgver() {
    cd "$srcdir/hyprland"
    local description
    description="$(git describe --long --tags --match 'v[0-9]*' 2>/dev/null || true)"
    if [[ "$description" =~ ^v([0-9]+(\.[0-9]+)+)-([0-9]+)-g([0-9a-f]+)$ ]]; then
        if [[ ${BASH_REMATCH[3]} == 0 ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
        else
            printf '%s.r%s.g%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
        fi
    else
        printf '0.0.0.r%s.g%s\n' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}
options=(!lto)
_stage_env() {
    export PATH="$srcdir/stage$_prefix/bin:$PATH"
    export PKG_CONFIG_PATH="$srcdir/stage$_prefix/lib/pkgconfig:$srcdir/stage$_prefix/share/pkgconfig"
    export CMAKE_PREFIX_PATH="$srcdir/stage$_prefix"
    export LD_LIBRARY_PATH="$srcdir/stage$_prefix/lib"
}
_stage_pc() {
    local file
    while IFS= read -r -d '' file; do
        sed -i "s|=\($_prefix\)|=$srcdir/stage\1|g" "$file"
    done < <(find "$srcdir/stage$_prefix" -name '*.pc' -print0)
}
_cmake() {
    local name=$1; shift
    local launchers=()
    if command -v ccache >/dev/null; then
        launchers=(-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache)
    fi
    cmake -S "$srcdir/trees/$name" -B "$srcdir/build-$name" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$_prefix" \
        -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_INCLUDEDIR=include \
        -DFETCHCONTENT_FULLY_DISCONNECTED=ON -DBUILD_TESTING=OFF \
        -DCMAKE_SKIP_RPATH=ON -DCMAKE_INSTALL_RPATH= \
        -DCMAKE_C_FLAGS="$CFLAGS" -DCMAKE_CXX_FLAGS="$CXXFLAGS" "${launchers[@]}" "$@"
    cmake --build "$srcdir/build-$name" --parallel "${JOBS:-2}"
    DESTDIR="$srcdir/stage" cmake --install "$srcdir/build-$name"
    _stage_pc
}
_validate_elf() {
    local file linkage
    while IFS= read -r -d '' file; do
        [[ $(head -c4 "$file") == $'\x7fELF' ]] || continue
        patchelf --remove-rpath "$file"
        readelf -h "$file" | grep -q 'Machine:.*AArch64' || return 1
        linkage=$(env -u LD_PRELOAD LD_LIBRARY_PATH="$pkgdir/usr/lib:$srcdir/stage/usr/lib" ldd "$file") || return 1
        [[ $linkage != *'not found'* ]] || { printf '%s\n' "$linkage" >&2; return 1; }
        if readelf -d "$file" | grep -Eq '(RPATH|RUNPATH)'; then
            printf 'Unexpected RPATH: %s\n' "$file" >&2; return 1
        fi
    done < <(find "$pkgdir/usr" -type f -print0)
}
prepare() {
    mkdir -p "$srcdir/trees"
    for name in hyprland aquamarine hyprgrass wf-touch; do
        cp -a "$srcdir/$name" "$srcdir/trees/$name"
        rm -rf "$srcdir/trees/$name/.git"
    done
    cp -a "$srcdir/udis86/." "$srcdir/trees/hyprland/subprojects/udis86/"
    cp -aL "$srcdir/anland-inputs/backend/aquamarine/." "$srcdir/trees/aquamarine/"
    mkdir -p "$srcdir/trees/aquamarine/src/backend/anland/public"
    cp -aL "$srcdir/anland-inputs/"{common,libdisplay_producer} "$srcdir/trees/aquamarine/src/backend/anland/public/"
    cp -aL "$srcdir/anland-inputs/backend/hyprland/." "$srcdir/trees/hyprland/"
    for name in aquamarine hyprland hyprgrass; do
        patch --batch --fuzz=2 --no-backup-if-mismatch -Np1 -d "$srcdir/trees/$name" -i "$srcdir/anland-inputs/patches/$name.patch"
    done
    rm -rf "$srcdir/trees/hyprgrass/subprojects/wf-touch"
    mv "$srcdir/trees/wf-touch" "$srcdir/trees/hyprgrass/subprojects/wf-touch"
}
build() {
    mkdir -p "$srcdir/stage"
    _stage_env
    export CFLAGS="$CFLAGS -ffile-prefix-map=$srcdir=/usr/src/hyprland-anland"
    export CXXFLAGS="$CXXFLAGS -ffile-prefix-map=$srcdir=/usr/src/hyprland-anland"
    _commit="$(git -C "$srcdir/hyprland" rev-parse HEAD)"
    export GIT_COMMIT_HASH="$_commit"
    export GIT_TAG="$(git -C "$srcdir/hyprland" describe --tags --always HEAD)"
    _cmake aquamarine -DCMAKE_INSTALL_INCLUDEDIR=include/aquamarine-anland
    _cmake hyprland -DNO_HYPRPM=OFF -DNO_UWSM=OFF -DNO_RTKIT=OFF -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    meson setup --reconfigure "$srcdir/build-hyprgrass" "$srcdir/trees/hyprgrass" --prefix="$_prefix" \
        --libdir=lib/hyprland/plugins --buildtype=release --wrap-mode=nodownload -Dtests=auto
    meson compile -C "$srcdir/build-hyprgrass" -j "${JOBS:-2}"
}
check() {
    meson test -C "$srcdir/build-hyprgrass" --print-errorlogs --num-processes "${JOBS:-2}"
}
package_hyprland-anland() {
    depends=("${_hyprland_depends[@]}" "${_anland_depends[@]}")
    provides=("hyprland=$pkgver" wayland-compositor 'aquamarine-anland' libaquamarine-anland.so)
    conflicts=(hyprland hyprland-git)
    for name in aquamarine hyprland; do
        DESTDIR="$pkgdir" cmake --install "$srcdir/build-$name"
    done
    # Same hyprland/hyprpm split and full SDK as the Arch Linux ARM recipe.
    rm -f "$pkgdir/usr/include/hyprland/src/version.h.in"
    find "$pkgdir" -name '*hyprpm*' -delete
    DESTDIR="$pkgdir" meson install -C "$srcdir/build-hyprgrass" --no-rebuild
    rm -f "$pkgdir/usr/lib/hyprland/plugins/libwftouch.a"
    install -Dm755 "$srcdir/anland-inputs/startup.sh" "$pkgdir/usr/bin/hyprland-anland"
    ln -s hyprctl "$pkgdir/usr/bin/hyprctl-anland"
    install -d "$pkgdir/usr/share/hypr"
    printf 'version=%s\nrevision=%s\n' "$pkgver" "$_commit" > "$pkgdir/usr/share/hypr/hyprland-anland-sdk"
    install -Dm644 "$srcdir/trees/hyprland/LICENSE" "$pkgdir/usr/share/licenses/hyprland/LICENSE"
    install -Dm644 "$srcdir/anland-inputs/LICENSE" "$pkgdir/usr/share/licenses/hyprland/anland-LICENSE"
    install -Dm644 "$srcdir/trees/aquamarine/LICENSE" "$pkgdir/usr/share/licenses/aquamarine-anland/LICENSE"
    install -Dm644 "$srcdir/trees/hyprgrass/LICENSE" "$pkgdir/usr/share/licenses/hyprgrass/LICENSE"
    install -Dm644 "$srcdir/trees/hyprgrass/subprojects/wf-touch/LICENSE" "$pkgdir/usr/share/licenses/wf-touch/LICENSE"
    install -Dm644 "$srcdir/anland-inputs/sources.json" "$pkgdir/usr/share/doc/$pkgname/sources.json"
    _validate_elf
}
package_hyprpm-anland() {
    pkgdesc='Hyprland plugin manager using the matching package-managed Anland SDK'
    depends=(cmake cpio glaze "hyprland-anland=$pkgver-$pkgrel" hyprland-protocols
        hyprwayland-scanner meson gcc git pkgconf ninja)
    optdepends=()
    provides=("hyprpm=$pkgver")
    conflicts=(hyprpm hyprpm-git)
    DESTDIR="$pkgdir" cmake --install "$srcdir/build-hyprland"
    find "$pkgdir" -type f,l -not -name '*hyprpm*' -delete
    find "$pkgdir" -type d -empty -delete
    install -Dm644 "$srcdir/trees/hyprland/LICENSE" "$pkgdir/usr/share/licenses/hyprpm/LICENSE"
    ln -s hyprpm "$pkgdir/usr/bin/hyprpm-anland"
    _validate_elf
}
