@@ -354,3 +354,60 @@ hl.window_rule({
     move  = "20 monitor_h-120",
     float = true,
 })
+
+
+-- ANLAND HYPRGRASS DEFAULTS BEGIN
+-- Built and shipped with this Hyprland; no hyprpm download/rebuild at login.
+-- Plugin loading happens after the initial parse; the namespace guard is needed
+-- for the first pass. Hyprland reparses when the plugin becomes available.
+hl.plugin.load("/usr/lib64/hyprland-anland/lib/hyprland/plugins/libhyprgrass.so")
+
+-- Native touchpad gestures: preserve the existing 3-finger horizontal workspace
+-- gesture above, and enable the remaining actions without overlapping patterns.
+hl.config({ gestures = { workspace_swipe_touch = true, workspace_swipe_cancel_ratio = 0.15 } })
+hl.gesture({ fingers = 3, direction = "up", action = "fullscreen" })
+hl.gesture({ fingers = 3, direction = "down", action = "close" })
+hl.gesture({ fingers = 3, direction = "pinch", action = "cursor_zoom", zoom_level = "2" })
+hl.gesture({ fingers = 4, direction = "horizontal", action = "move" })
+hl.gesture({ fingers = 4, direction = "vertical", action = "float" })
+hl.gesture({ fingers = 4, direction = "pinch", action = "resize" })
+hl.gesture({ fingers = 5, direction = "up", action = "special", workspace_name = "magic" })
+hl.gesture({ fingers = 5, direction = "down", action = "resize" })
+hl.gesture({ fingers = 5, direction = "horizontal", action = "scroll_move" })
+hl.gesture({ fingers = 5, direction = "pinch", action = "resize" })
+
+if hl.plugin.hyprgrass then
+    hl.config({ plugin = { hyprgrass = {
+        sensitivity = 4.0,
+        long_press_delay = 400,
+        edge_margin = 20,
+        resize_on_border_long_press = true,
+        debug = { send_cancel = true },
+    } } })
+    local hg = hl.plugin.hyprgrass
+    -- Touchscreen multi-finger gestures (requires consumer forwarding contacts).
+    hg.gesture({ pattern = {kind = "swipe", fingers = 3, direction = "horizontal"}, action = "workspace" })
+    hg.gesture({ pattern = {kind = "swipe", fingers = 3, direction = "up"}, action = "fullscreen" })
+    hg.gesture({ pattern = {kind = "swipe", fingers = 3, direction = "down"}, action = "close" })
+    hg.gesture({ pattern = {kind = "swipe", fingers = 4, direction = "horizontal"}, action = "move" })
+    hg.gesture({ pattern = {kind = "swipe", fingers = 4, direction = "vertical"}, action = "float" })
+    hg.gesture({ pattern = {kind = "swipe", fingers = 5, direction = "up"}, action = "special", workspace_name = "magic" })
+    hg.gesture({ pattern = {kind = "swipe", fingers = 5, direction = "down"}, action = "resize" })
+    hg.gesture({ pattern = {kind = "swipe", fingers = 5, direction = "horizontal"}, action = "scroll_move" })
+    -- Edge gestures: bottom sideways = workspace; top down = special workspace.
+    hg.gesture({ pattern = {kind = "edge", origin = "down", direction = "horizontal"}, action = "workspace" })
+    hg.gesture({ pattern = {kind = "edge", origin = "up", direction = "down"}, action = "special", workspace_name = "magic" })
+    hg.bind({ pattern = {kind = "edge", origin = "left", direction = "right"}, action = hl.dsp.exec_cmd(menu) })
+    hg.bind({ pattern = {kind = "edge", origin = "right", direction = "left"}, action = hl.dsp.exec_cmd(terminal) })
+    -- Long-press drag: one finger moves; two fingers resize; borders also resize.
+    hg.gesture({ pattern = {kind = "longpress", fingers = 1, direction = "swipe"}, action = "move" })
+    hg.gesture({ pattern = {kind = "longpress", fingers = 2, direction = "swipe"}, action = "resize" })
+    -- Multi-tap and pinch binds, plus live pinch and touchpad emulation.
+    hg.bind({ pattern = {kind = "tap", fingers = 3}, action = hl.dsp.window.float() })
+    hg.bind({ pattern = {kind = "tap", fingers = 4}, action = hl.dsp.window.fullscreen() })
+    hg.gesture({ pattern = {kind = "pinch", fingers = 3, direction = "pinch"}, action = "cursor_zoom", zoom_level = "2" })
+    hg.bind({ pattern = {kind = "pinch", fingers = 4, direction = "pinchin"}, action = hl.dsp.window.float() })
+    hg.bind({ pattern = {kind = "pinch", fingers = 4, direction = "pinchout"}, action = hl.dsp.window.fullscreen() })
+    hg.gesture({ pattern = {kind = "pinch", fingers = 5, direction = "pinch"}, action = "emulate_touchpad" })
+end
+-- ANLAND HYPRGRASS DEFAULTS END
