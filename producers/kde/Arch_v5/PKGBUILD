# Maintainer: anland contributors
# Arch Linux ARM KWin 6.8.0 release plus the shared Anland backend.

pkgname=kwin
pkgver=6.8.0
pkgrel=1.1
pkgdesc='An easy to use, but flexible, Wayland compositor (anland backend)'
arch=('aarch64')
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
groups=('plasma')

depends=(
  'aurorae>=6.8.0' 'breeze>=6.8.0' glibc iio-sensor-proxy 'plasma-activities>=6.8.0' kauth kcmutils
  kcolorscheme kconfig kcoreaddons kcrash kdbusaddons kdeclarative
  'kdecoration>=6.8.0' kglobalaccel 'kglobalacceld>=6.8.0' kguiaddons ki18n kidletime kirigami
  kitemmodels knewstuff 'knighttime>=6.8.0' knotifications kpackage kquickcharts
  krunner 'kscreenlocker>=6.8.0' kservice ksvg 'kwayland>=6.8.0' kwidgetsaddons kwindowsystem kxmlgui
  lcms2 libcanberra libdisplay-info libdrm libei libepoxy libevdev libgcc
  libinput libpipewire libqaccessibilityclient-qt6 libstdc++ libxcb libxcvt
  libxkbcommon mesa 'milou>=6.8.0' pipewire-session-manager 'libplasma>=6.8.0' qt6-5compat
  'qt6-base>=6.12.0' qt6-declarative qt6-svg qt6-tools systemd-libs vulkan-icd-loader
  'wayland>=1.26.0' xcb-util-keysyms xcb-util-wm
)
makedepends=(
  cmake 'extra-cmake-modules>=6.30.0' kdoctools krunner ninja 'plasma-wayland-protocols>=1.23.0'
  python vulkan-headers 'wayland-protocols>=1.49' xorg-xwayland
)
optdepends=('plasma-keyboard: virtual keyboard')
# Upstream release hash is also published by Arch's kwin 6.8.0-1 PKGBUILD.
source=("https://download.kde.org/stable/plasma/$pkgver/kwin-$pkgver.tar.xz"
        'kwin.patch' 'anland-overlay.tar')
noextract=('anland-overlay.tar')
# build.sh replaces the generated overlay checksum in its staged recipe.
sha256sums=('4bfaf31e29a8f9fdf231dc3bbb9b09b0ce07cae9fee7a01cfc86425ece796258'
            '2e654793357d00c5ec154de97b1b74584b5951742c5fe44a9a77ae4d38ab8f59'
            'SKIP')

require_aarch64() {
  [[ "$(uname -m)" == 'aarch64' && "${CARCH:-}" == 'aarch64' ]] || {
    error 'this package must be built natively on Arch Linux ARM (aarch64)'
    return 1
  }
}

prepare() {
  require_aarch64 || return 1
  local tree="$srcdir/kwin-$pkgver"
  [[ -d "$tree" ]] || { error 'KWin release source tree is missing'; return 1; }
  # The generated archive uses kwin/src/...; unpack into the versioned release.
  tar -xf "$srcdir/anland-overlay.tar" --strip-components=1 -C "$tree"
  [[ -d "$tree/src/backends/anland" ]] || {
    error 'anland backend overlay is missing'; return 1;
  }
  patch --batch --forward --fuzz=0 --no-backup-if-mismatch -Np1 -d "$tree" -i "$srcdir/kwin.patch"
}

build() {
  local tree="$srcdir/kwin-$pkgver"
  local cmake_args=(
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR=lib
    -DKDE_INSTALL_LIBEXECDIR=lib
    # Arch Qt searches /usr/lib/qt6/{qml,plugins}. Keep private effects and
    # KWin plugins in the same Qt installation as Plasma's runtime modules.
    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
    -DBUILD_TESTING=OFF
  )
  # Optional, private native dependencies for testing without upgrading Plasma.
  # A finished package still requires the 6.8 runtime dependencies above.
  if [[ -n "${ANLAND_KWIN_DEPS_PREFIX:-}" ]]; then
    [[ "$ANLAND_KWIN_DEPS_PREFIX" == /* && -d "$ANLAND_KWIN_DEPS_PREFIX/lib/cmake" ]] || {
      error 'ANLAND_KWIN_DEPS_PREFIX must be an absolute native dependency prefix'; return 1;
    }
    cmake_args+=("-DCMAKE_PREFIX_PATH=$ANLAND_KWIN_DEPS_PREFIX")
  fi
  cmake -S "$tree" -B "$tree/build" -G Ninja "${cmake_args[@]}"
  cmake --build "$tree/build" --parallel "${JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/kwin-$pkgver/build"
}
