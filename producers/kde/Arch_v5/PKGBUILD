# Maintainer: anland contributors
# KWin 6.7.4 rebuilt with the native anland output/input backend.

pkgname=kwin
pkgver=6.7.4
pkgrel=1.1
pkgdesc='An easy to use, but flexible, Wayland compositor (anland backend)'
arch=('aarch64')
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')

depends=(
  aurorae breeze glibc iio-sensor-proxy plasma-activities kauth kcmutils
  kcolorscheme kconfig kcoreaddons kcrash kdbusaddons kdeclarative
  kdecoration kglobalaccel kglobalacceld kguiaddons ki18n kidletime kirigami
  kitemmodels knewstuff knighttime knotifications kpackage kquickcharts
  kscreenlocker kservice ksvg kwayland kwidgetsaddons kwindowsystem kxmlgui
  lcms2 libcanberra libdisplay-info libdrm libei libepoxy libevdev libgcc
  libinput libpipewire libqaccessibilityclient-qt6 libstdc++ libxcb libxcvt
  libxkbcommon mesa milou pipewire-session-manager libplasma qt6-5compat
  qt6-base qt6-declarative qt6-svg qt6-tools systemd-libs vulkan-icd-loader
  wayland 'wireplumber>=0.5.18' xcb-util-keysyms xcb-util-wm
)
makedepends=(
  cmake extra-cmake-modules kdoctools krunner ninja plasma-wayland-protocols
  python vulkan-headers wayland-protocols xorg-xwayland
)
optdepends=('plasma-keyboard: virtual keyboard')
source=(
  "kwin-${pkgver}.tar.xz::https://download.kde.org/stable/plasma/${pkgver}/kwin-${pkgver}.tar.xz"
  'kwin.patch'
  'anland-overlay.tar'
)
noextract=('anland-overlay.tar')
sha256sums=(
  'db7a7dba71aaca1e5218733b80f90a998d84e2ab36e4d62d0e3ea00376c5802d'
  'SKIP'
  'SKIP'
)

require_aarch64() {
  [[ "$(uname -m)" == 'aarch64' && "${CARCH:-}" == 'aarch64' ]] || {
    error 'this package must be built natively on Arch Linux ARM (aarch64)'
    return 1
  }
}

prepare() {
  require_aarch64 || return 1

  local tree="$srcdir/kwin-$pkgver"
  [[ -d "$tree" ]] || { error "KWin source tree is missing"; return 1; }

  # The overlay is generated by build.sh from the checked-in Arch backend.
  # Keeping it outside the source tarball makes the source layout identical to
  # the upstream release and keeps makepkg's file ownership complete.
  tar -xf "$srcdir/anland-overlay.tar" -C "$srcdir"
  [[ -d "$tree/src/backends/anland" ]] || {
    error 'anland backend overlay is missing'; return 1;
  }

  patch -Np1 -d "$tree" -i "$srcdir/kwin.patch"
}

build() {
  local tree="$srcdir/kwin-$pkgver"
  cmake -S "$tree" -B "$tree/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build "$tree/build" --parallel "${JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/kwin-$pkgver/build"
}
