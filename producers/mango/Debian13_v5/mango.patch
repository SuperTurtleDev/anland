diff --git a/scripts/anland-volume.sh b/scripts/anland-volume.sh
new file mode 100755
index 00000000..a0671e51
--- /dev/null
+++ b/scripts/anland-volume.sh
@@ -0,0 +1,75 @@
+#!/bin/sh
+set -eu
+
+RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
+STATE=${ANLAND_VOLUME_STATE:-$RUNTIME_DIR/anland-volume-state}
+LOCK=${STATE}.lock
+STEP=${ANLAND_VOLUME_STEP:-5}
+DEFAULT_VOLUME=${ANLAND_VOLUME_DEFAULT:-100}
+
+mkdir -p "$RUNTIME_DIR"
+
+read_state() {
+    if [ -r "$STATE" ]; then
+        set -- $(cat "$STATE")
+        vol=${1:-$DEFAULT_VOLUME}
+        muted=${2:-0}
+    else
+        vol=$DEFAULT_VOLUME
+        muted=0
+    fi
+    case "$vol" in ''|*[!0-9]*) vol=$DEFAULT_VOLUME ;; esac
+    case "$muted" in 1) muted=1 ;; *) muted=0 ;; esac
+    if [ "$vol" -lt 0 ]; then vol=0; fi
+    if [ "$vol" -gt 150 ]; then vol=150; fi
+}
+
+write_state() {
+    tmp="$STATE.$$"
+    printf '%s %s\n' "$vol" "$muted" > "$tmp"
+    mv "$tmp" "$STATE"
+}
+
+with_lock() {
+    exec 9>"$LOCK"
+    flock 9
+    read_state
+    case "$1" in
+        get)
+            printf '%s %s\n' "$vol" "$muted"
+            ;;
+        up)
+            vol=$((vol + STEP))
+            if [ "$vol" -gt 150 ]; then vol=150; fi
+            muted=0
+            write_state
+            printf '%s %s\n' "$vol" "$muted"
+            ;;
+        down)
+            vol=$((vol - STEP))
+            if [ "$vol" -lt 0 ]; then vol=0; fi
+            muted=0
+            write_state
+            printf '%s %s\n' "$vol" "$muted"
+            ;;
+        toggle)
+            if [ "$muted" = 1 ]; then muted=0; else muted=1; fi
+            write_state
+            printf '%s %s\n' "$vol" "$muted"
+            ;;
+        set)
+            vol=${2:-}
+            case "$vol" in ''|*[!0-9]*) echo "Usage: $0 set <0-150>" >&2; exit 2 ;; esac
+            if [ "$vol" -gt 150 ]; then vol=150; fi
+            muted=0
+            write_state
+            printf '%s %s\n' "$vol" "$muted"
+            ;;
+        *)
+            echo "Usage: $0 {get|up|down|toggle|set <0-150>}" >&2
+            exit 2
+            ;;
+    esac
+}
+
+with_lock "${1:-get}" "${2:-}"
diff --git a/scripts/mango-anland b/scripts/mango-anland
new file mode 100755
index 00000000..3844f4b0
--- /dev/null
+++ b/scripts/mango-anland
@@ -0,0 +1,82 @@
+#!/bin/sh
+set -eu
+
+SERVICE=mango-anland.service
+RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
+LOCK_FILE="$RUNTIME_DIR/mango-anland.lock"
+
+export ANLAND=1
+export ANLAND_SOCKET=${ANLAND_SOCKET:-/run/display.sock}
+export ANLAND_DRM_DEVICE=${ANLAND_DRM_DEVICE:-/dev/dri/renderD128}
+export WLR_RENDER_DRM_DEVICE=${WLR_RENDER_DRM_DEVICE:-$ANLAND_DRM_DEVICE}
+export XWAYLAND_GBM_DEVICE=${XWAYLAND_GBM_DEVICE:-$ANLAND_DRM_DEVICE}
+export ANLAND_SKIP_IMPLICIT_SYNC_WAIT=${ANLAND_SKIP_IMPLICIT_SYNC_WAIT:-1}
+export XDG_RUNTIME_DIR="$RUNTIME_DIR"
+export PULSE_SERVER=${PULSE_SERVER:-unix:$RUNTIME_DIR/pulse/native}
+export XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-wayland}
+export XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-mango}
+export MESA_LOADER_DRIVER_OVERRIDE=${MESA_LOADER_DRIVER_OVERRIDE:-kgsl}
+export GALLIUM_DRIVER=${GALLIUM_DRIVER:-zink}
+export WLR_RENDERER_ALLOW_SOFTWARE=${WLR_RENDERER_ALLOW_SOFTWARE:-1}
+
+wait_for_anland() {
+    i=0
+    while [ "$i" -lt 60 ]; do
+        if [ -S "$ANLAND_SOCKET" ] && [ -e "$ANLAND_DRM_DEVICE" ]; then
+            return 0
+        fi
+        i=$((i + 1))
+        sleep 0.5
+    done
+    echo "mango-anland: Anland socket or DRM device is unavailable" >&2
+    return 1
+}
+
+run_mango() {
+    wait_for_anland
+    command -v mango >/dev/null 2>&1 || {
+        echo "mango-anland: mango executable is unavailable" >&2
+        return 1
+    }
+    command -v mangobar >/dev/null 2>&1 || {
+        echo "mango-anland: mangobar executable is unavailable" >&2
+        return 1
+    }
+    mkdir -p "$RUNTIME_DIR"
+    exec 9>"$LOCK_FILE"
+    if ! flock -n 9; then
+        echo "mango-anland: session is already running" >&2
+        return 1
+    fi
+    exec mango -s 'while :; do mangobar; sleep 1; done'
+}
+
+case "${1:-start}" in
+    start)
+        if [ "${MANGO_ANLAND_SYSTEMD:-0}" = 1 ]; then
+            run_mango
+        else
+            exec systemctl --user start "$SERVICE"
+        fi
+        ;;
+    stop)
+        exec systemctl --user stop "$SERVICE"
+        ;;
+    restart)
+        exec systemctl --user restart "$SERVICE"
+        ;;
+    kill)
+        systemctl --user stop "$SERVICE" || true
+        systemctl --user reset-failed "$SERVICE" || true
+        ;;
+    status)
+        exec systemctl --user status "$SERVICE"
+        ;;
+    run)
+        run_mango
+        ;;
+    *)
+        echo "Usage: $0 {start|stop|restart|kill|status|run}" >&2
+        exit 2
+        ;;
+esac
diff --git a/src/ext-protocol/text-input.c b/src/ext-protocol/text-input.c
--- a/src/ext-protocol/text-input.c
+++ b/src/ext-protocol/text-input.c
@@ -11,7 +11,63 @@
 #include <wlr/types/wlr_layer_shell_v1.h>
 #include <wlr/types/wlr_output_layout.h>
 #include <wlr/types/wlr_virtual_keyboard_v1.h>
+#include "anland_backend/anland.h"
+#include <stdint.h>
+#include <wlr/util/log.h>
 #include <wlr/types/wlr_xdg_shell.h>
+
+static bool valid_utf8(const char *text) {
+	const unsigned char *s = (const unsigned char *)text;
+	while (*s) {
+		uint32_t cp;
+		size_t n;
+		if (*s < 0x80) { s++; continue; }
+		if ((*s & 0xe0) == 0xc0) { cp = *s & 0x1f; n = 1; if (cp < 2) return false; }
+		else if ((*s & 0xf0) == 0xe0) { cp = *s & 0x0f; n = 2; }
+		else if ((*s & 0xf8) == 0xf0) { cp = *s & 0x07; n = 3; }
+		else return false;
+		for (size_t i = 0; i < n; i++) { if ((s[i + 1] & 0xc0) != 0x80) return false; cp = (cp << 6) | (s[i + 1] & 0x3f); }
+		if ((n == 2 && cp < 0x800) || (n == 3 && cp < 0x10000) ||
+				cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff)) return false;
+		s += n + 1;
+	}
+	return true;
+}
+
+bool mango_text_input_commit_utf8(struct mango_input_method_relay *relay,
+		const char *text, size_t length) {
+	/* commit_string is one Wayland string event, not an arbitrary byte stream.
+	 * Keep its header, NUL and padding below the default 4096-byte buffer.
+	 * Do not split into several commit_string events before one done: v3
+	 * double-buffers that value and clients may retain only the last chunk. */
+	if (!text || length == 0 || length > 4000 || memchr(text, '\0', length)) {
+		wlr_log(WLR_ERROR, "Anland text rejected: invalid payload or length > 4000 (%zu bytes)", length);
+		return false;
+	}
+	struct wlr_surface *focus = server.seat ?
+		server.seat->keyboard_state.focused_surface : NULL;
+	if (!relay || !relay->compositor_input_method || !focus ||
+			relay->focused_surface != focus || !relay->active_text_input) {
+		wlr_log(WLR_DEBUG, "Anland text rejected: no synchronized keyboard/text-input focus");
+		return false;
+	}
+	struct wlr_text_input_v3 *input = relay->active_text_input->input;
+	if (!input->current_enabled || input->focused_surface != focus ||
+			wl_resource_get_client(input->resource) != wl_resource_get_client(focus->resource)) {
+		wlr_log(WLR_DEBUG, "Anland text rejected: text-input-v3 disabled or wrong surface");
+		return false;
+	}
+	char *copy = strndup(text, length);
+	if (!copy || !valid_utf8(copy)) {
+		wlr_log(WLR_ERROR, "Anland text rejected: allocation failure or invalid UTF-8");
+		free(copy);
+		return false;
+	}
+	wlr_text_input_v3_send_commit_string(input, copy);
+	wlr_text_input_v3_send_done(input);
+	free(copy);
+	return true; /* Queued to Wayland, not proof the application consumed it. */
+}
 
