 }
+
+// Paired with create_local_ime; only used by local backend-owned IMEs.
+void destroy_local_ime(struct wlserver_input_method *ime)
+{
+    if (!ime) return;
+    if (ime->local_text_timer) wl_event_source_remove(ime->local_text_timer);
+    wl_event_source_remove(ime->ime_reset_ime_keyboard_event_source);
+    wl_event_source_remove(ime->ime_release_ime_keypress_event_source);
+    release_key_if_needed(ime);
+    destroy_ime(ime);
+    free(ime->pending.string);
+    delete ime;
+}
