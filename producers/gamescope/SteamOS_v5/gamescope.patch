+static int local_text_tick(void *data)
+{
+    auto *ime = static_cast<wlserver_input_method *>(data);
+    if (ime->local_text.empty()) return 0;
+    // At most 32 code points per generated keymap (pool contains 47 slots).
+    // Wait for the previous key release/keymap restore before reusing slots.
+    reset_ime_keyboard(ime);
+    size_t end = 0;
+    for (unsigned count = 0; count < 32 && end < ime->local_text.size(); ++count)
+        end += utf8_size(ime->local_text.c_str() + end);
+    std::string batch = ime->local_text.substr(0, end);
+    ime->local_text.erase(0, end);
+    type_text(ime, batch.c_str());
+    wl_event_source_timer_update(ime->manager->ime_reset_keyboard_event_source, 100);
+    if (!ime->local_text.empty()) wl_event_source_timer_update(ime->local_text_timer, 120);
+    return 0;
+}
+
+bool type_local_text(struct wlserver_input_method *ime, const char *text)
+{
+    if (!ime || !ime->local_text_timer || !text) return false;
+    const size_t size = strlen(text);
+    if (size > 65536 || ime->local_text.size() + size > 65536) return false;
+    // Validate here too: the timer must always advance on a complete code point.
+    for (size_t i = 0; i < size;) {
+        unsigned char c = text[i];
+        size_t n = c < 0x80 ? 1 : c >= 0xC2 && c <= 0xDF ? 2 :
+            c >= 0xE0 && c <= 0xEF ? 3 : c >= 0xF0 && c <= 0xF4 ? 4 : 0;
+        if (!n || i + n > size) return false;
+        for (size_t j=1; j<n; ++j)
+            if ((static_cast<unsigned char>(text[i+j]) & 0xC0) != 0x80) return false;
+        if (n == 3 && ((c == 0xE0 && (unsigned char)text[i+1] < 0xA0) ||
+                       (c == 0xED && (unsigned char)text[i+1] >= 0xA0))) return false;
+        if (n == 4 && ((c == 0xF0 && (unsigned char)text[i+1] < 0x90) ||
+                       (c == 0xF4 && (unsigned char)text[i+1] >= 0x90))) return false;
+        i += n;
+    }
+    bool idle = ime->local_text.empty();
+    ime->local_text += text;
+    // Do not restart an armed batch timer: a burst must not shorten keymap lifetime.
+    if (idle && size) wl_event_source_timer_update(ime->local_text_timer, 120);
+    return true;
+}
+
 struct wlserver_input_method *create_local_ime()
 {
 	struct wlserver_input_method *ime = new wlserver_input_method();
 	ime->resource = nullptr;
 	ime->manager = global_manager;
+    ime->local_text_timer = wl_event_loop_add_timer(global_manager->server->event_loop, local_text_tick, ime);
 	ime->serial = 1;
 	ime->next_keycode_index = 0;
 	ime->held_keycode = -1;
@@ -601,6 +651,13 @@
 	ime->ime_reset_ime_keyboard_event_source = wl_event_loop_add_timer(global_manager->server->event_loop, reset_ime_keyboard, ime);
 	ime->ime_release_ime_keypress_event_source = wl_event_loop_add_timer(global_manager->server->event_loop, release_key_if_needed, ime);
 
+    if (!ime->local_text_timer || !ime->ime_reset_ime_keyboard_event_source ||
+        !ime->ime_release_ime_keypress_event_source) {
+        if (ime->local_text_timer) wl_event_source_remove(ime->local_text_timer);
+        if (ime->ime_reset_ime_keyboard_event_source) wl_event_source_remove(ime->ime_reset_ime_keyboard_event_source);
+        if (ime->ime_release_ime_keypress_event_source) wl_event_source_remove(ime->ime_release_ime_keypress_event_source);
+        destroy_ime(ime); delete ime; return nullptr;
+    }
 	return ime;
 }
 
@@ -644,3 +701,16 @@
 
