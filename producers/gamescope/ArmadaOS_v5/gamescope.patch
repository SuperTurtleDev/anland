 #include <vector>
 
@@ -112,6 +115,8 @@ struct wlserver_input_method {
 	struct wl_event_source *ime_reset_ime_keyboard_event_source;
 	struct wl_event_source *ime_release_ime_keypress_event_source;
 
+    std::string local_text;
+    struct wl_event_source *local_text_timer = nullptr;
 	uint32_t uFakeTimestamp = 0;
 };
 
@@ -592,8 +597,69 @@ static void manager_handle_create_input_method(struct wl_client *client, struct
 	ime->ime_release_ime_keypress_event_source = wl_event_loop_add_timer(manager->server->event_loop, release_key_if_needed, ime);
 }
 
+static int local_text_tick(void *data)
+{
+    auto *ime = static_cast<wlserver_input_method *>(data);
+    if (ime->local_text.empty()) return 0;
+
+    // Send one complete UTF-8 code point per timer tick.
+    reset_ime_keyboard(ime);
+    const size_t end = utf8_size(ime->local_text.c_str());
+    if (!end || end > ime->local_text.size()) {
+        ime->local_text.clear();
+        return 0;
+    }
+    std::string batch = ime->local_text.substr(0, end);
+    ime->local_text.erase(0, end);
+    type_text(ime, batch.c_str());
+    wl_event_source_timer_update(ime->manager->ime_reset_keyboard_event_source, 100);
+    if (!ime->local_text.empty())
+        wl_event_source_timer_update(ime->local_text_timer, 150);
+    return 0;
+}
+
+bool type_local_text(struct wlserver_input_method *ime, const char *text, size_t size)
+{
+    if (!ime || !ime->local_text_timer || !text) return false;
+    if (size > 65536 || ime->local_text.size() + size > 65536) return false;
+
+    for (size_t i = 0; i < size;) {
+        const unsigned char c = static_cast<unsigned char>(text[i]);
+        const size_t n = c == 0 ? 0 : c < 0x80 ? 1 :
+            c >= 0xC2 && c <= 0xDF ? 2 :
+            c >= 0xE0 && c <= 0xEF ? 3 :
+            c >= 0xF0 && c <= 0xF4 ? 4 : 0;
+        if (!n || i + n > size) return false;
+        for (size_t j = 1; j < n; ++j)
+            if ((static_cast<unsigned char>(text[i + j]) & 0xC0) != 0x80) return false;
+        if (n == 3 && ((c == 0xE0 && static_cast<unsigned char>(text[i + 1]) < 0xA0) ||
+                       (c == 0xED && static_cast<unsigned char>(text[i + 1]) >= 0xA0))) return false;
+        if (n == 4 && ((c == 0xF0 && static_cast<unsigned char>(text[i + 1]) < 0x90) ||
+                       (c == 0xF4 && static_cast<unsigned char>(text[i + 1]) >= 0x90))) return false;
+        i += n;
+    }
+
+    const bool idle = ime->local_text.empty();
+    ime->local_text.append(text, size);
+    // Do not restart an armed timer: bursts must not shorten keymap lifetime.
+    if (idle && size)
+        wl_event_source_timer_update(ime->local_text_timer, 150);
+    return true;
+}
+
+void cancel_local_text(struct wlserver_input_method *ime)
+{
+    if (!ime) return;
+    ime->local_text.clear();
+    if (ime->local_text_timer)
+        wl_event_source_timer_update(ime->local_text_timer, 0);
+    reset_ime_keyboard(ime);
+}
+
 struct wlserver_input_method *create_local_ime()
 {
+	if (!global_manager || !global_manager->server)
+		return nullptr;
 	struct wlserver_input_method *ime = new wlserver_input_method();
 	ime->resource = nullptr;
 	ime->manager = global_manager;
@@ -607,9 +673,30 @@ struct wlserver_input_method *create_local_ime()
 
 	wlr_keyboard_set_repeat_info(&ime->keyboard, 0, 0);
 
+    ime->local_text_timer = wl_event_loop_add_timer(global_manager->server->event_loop, local_text_tick, ime);
 	ime->ime_reset_ime_keyboard_event_source = wl_event_loop_add_timer(global_manager->server->event_loop, reset_ime_keyboard, ime);
 	ime->ime_release_ime_keypress_event_source = wl_event_loop_add_timer(global_manager->server->event_loop, release_key_if_needed, ime);
 
+    if (!ime->local_text_timer || !ime->ime_reset_ime_keyboard_event_source ||
+        !ime->ime_release_ime_keypress_event_source) {
+        if (ime->local_text_timer) {
+            wl_event_source_remove(ime->local_text_timer);
+            ime->local_text_timer = nullptr;
+        }
+        if (ime->ime_reset_ime_keyboard_event_source &&
+            ime->ime_release_ime_keypress_event_source) {
+            destroy_ime(ime);
+        } else {
+            if (ime->ime_reset_ime_keyboard_event_source)
+                wl_event_source_remove(ime->ime_reset_ime_keyboard_event_source);
+            if (ime->ime_release_ime_keypress_event_source)
+                wl_event_source_remove(ime->ime_release_ime_keypress_event_source);
+            wlr_keyboard_finish(&ime->keyboard);
+            free(ime->pending.string);
+        }
+        delete ime;
+        return nullptr;
+    }
 	return ime;
 }
 
@@ -653,3 +740,16 @@ void create_ime_manager(struct wlserver_t *wlserver)
 
 	global_manager = manager;
 }
+
+// Paired with create_local_ime; only used by local backend-owned IMEs.
+void destroy_local_ime(struct wlserver_input_method *ime)
+{
+    if (!ime) return;
+    cancel_local_text(ime);
+    if (ime->local_text_timer) {
+        wl_event_source_remove(ime->local_text_timer);
+        ime->local_text_timer = nullptr;
+    }
+    destroy_ime(ime);
+    delete ime;
+}
