 #include <sys/stat.h>
 // For limiter file.
 #include <time.h>
@@ -585,6 +587,35 @@ namespace GamescopeWSILayer {
     // Cached for comparison.
     std::optional<VkRect2D> cachedWindowRect;
 
+    // canBypassXWayland costs several X round trips, and the answer only changes when a
+    // client is remapped, so it is re-checked at most every GAMESCOPE_WSI_BYPASS_CHECK_MS
+    // (default 100). Set it to 0 to query on every present.
+    std::optional<bool> presentBypass;
+    bool presentBypassHdr = false;
+    uint64_t presentBypassNs = 0;
+
+    static uint64_t presentBypassIntervalNs() {
+      static const uint64_t interval = [] {
+        const char *v = getenv("GAMESCOPE_WSI_BYPASS_CHECK_MS");
+        return uint64_t(v && *v ? strtoull(v, nullptr, 10) : 100) * 1000000ull;
+      }();
+      return interval;
+    }
+
+    bool canBypassXWaylandAtPresent(bool hdrColorspace) {
+      if (isWayland())
+        return true;
+      timespec ts;
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+      const uint64_t now = uint64_t(ts.tv_sec) * 1000000000ull + uint64_t(ts.tv_nsec);
+      if (!presentBypass || presentBypassHdr != hdrColorspace || now - presentBypassNs >= presentBypassIntervalNs()) {
+        presentBypass = canBypassXWayland(hdrColorspace);
+        presentBypassHdr = hdrColorspace;
+        presentBypassNs = now;
+      }
+      return *presentBypass;
+    }
+
     bool isWayland() const {
       // Is native Wayland?
       return connection == nullptr;
