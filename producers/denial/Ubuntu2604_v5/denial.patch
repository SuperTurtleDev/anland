+//! Native pointer-lock ownership; no transport or Android capture confirmation.
+#[derive(Clone, Copy, Default)]
+pub(crate) struct CaptureFacts {
+    pub active_locked: bool,
+    pub same_client_focus: bool,
+    pub escaped: bool,
+    pub shell_owns_keyboard: bool,
+    pub shell_pointer_press: bool,
+    pub dragging: bool,
+}
+impl CaptureFacts {
+    pub fn requested(self) -> bool {
+        self.active_locked
+            && self.same_client_focus
+            && !self.escaped
+            && !self.shell_owns_keyboard
+            && !self.shell_pointer_press
+            && !self.dragging
+    }
+}
