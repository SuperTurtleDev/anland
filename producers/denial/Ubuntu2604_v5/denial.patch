+    /// Query only: never activate a client's constraint or infer capture from
+    /// ordinary button grabs. The existing native routes decide lock ownership.
+    pub(crate) fn consumer_pointer_capture_requested(&self, shell_pointer_press: bool) -> bool {
+        use super::capture_policy::CaptureFacts;
+        use smithay::utils::IsAlive;
+        use smithay::wayland::seat::WaylandFocus;
+        let Some(pointer) = self.seat.get_pointer() else {
+            return false;
+        };
+        let Some(surface) = pointer.current_focus().filter(|surface| surface.is_alive()) else {
+            return false;
+        };
+        let keyboard_focus = self
+            .seat
+            .get_keyboard()
+            .and_then(|keyboard| keyboard.current_focus());
+        let same_client_focus = keyboard_focus.as_ref().is_some_and(|focus| {
+            focus.alive()
+                && focus
+                    .wl_surface()
+                    .is_some_and(|focused| focused.as_ref() == &*surface)
+        });
+        let active_locked = with_pointer_constraint(&surface, &pointer, |constraint| {
+            constraint.is_some_and(|constraint| {
+                constraint.is_active() && matches!(&*constraint, PointerConstraint::Locked(_))
+            })
+        });
+        CaptureFacts {
+            active_locked,
+            same_client_focus,
+            escaped: self.pointer_constraint_released_for_surface(&surface),
+            shell_owns_keyboard: self.shell_captures_keyboard(),
+            shell_pointer_press,
+            dragging: self.clipboard_drag_active,
+        }
+        .requested()
+    }
+
+    /// Input disconnect/engine retirement cannot leave a native lock active for
+    /// a replacement consumer. Normal input reset handles real key/button ups.
+    pub(crate) fn release_consumer_pointer_constraint(&mut self) {
+        if let Some(pointer) = self.seat.get_pointer()
+            && let Some(surface) = pointer.current_focus()
+        {
+            with_pointer_constraint(&surface, &pointer, |constraint| {
+                if let Some(constraint) = constraint {
+                    constraint.deactivate();
+                }
+            });
+        }
+    }
