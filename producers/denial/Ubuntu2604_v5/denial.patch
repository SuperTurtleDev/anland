index 0000000..8e9c1f3
--- /dev/null
+++ b/compositor/src/bin/deniald/flutter_runtime/scene_recovery.rs
@@ -0,0 +1,145 @@
+//! Local cold-scene barrier; no consumer protocol or transport ownership here.
+use std::time::{Duration, Instant};
+
+pub(crate) const RECOVERY_TIMEOUT: Duration = Duration::from_secs(3);
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct SceneVersion {
+    pub metadata: u64,
+    pub lock_epoch: Option<u64>,
+}
+#[derive(Debug)]
+pub(crate) struct RecoveryGate {
+    generation: u64,
+    started: Instant,
+    revision: u64,
+    version: Option<SceneVersion>,
+    acknowledged: bool,
+    finished: bool,
+    layout_epoch: u64,
+    layout_baseline: u64,
+}
+impl RecoveryGate {
+    pub fn new(generation: u64, started: Instant) -> Self {
+        assert_ne!(generation, 0);
+        Self {
+            generation,
+            started,
+            revision: 0,
+            version: None,
+            acknowledged: false,
+            finished: false,
+            layout_epoch: 0,
+            layout_baseline: 0,
+        }
+    }
+    /// A resident engine keeps its layout epoch and monotonically increasing
+    /// local revision. Delayed ACKs from a previous pool cannot reopen this gate.
+    pub fn restart(&mut self, started: Instant) {
+        self.started = started;
+        self.version = None;
+        self.acknowledged = false;
+        self.finished = false;
+        self.layout_baseline = self.layout_epoch;
+    }
+    pub fn finished(&self) -> bool {
+        self.finished
+    }
+    pub fn expired(&self, now: Instant) -> bool {
+        !self.finished && now.saturating_duration_since(self.started) >= RECOVERY_TIMEOUT
+    }
+    pub fn invalidate(&mut self) {
+        if !self.finished {
+            self.version = None;
+            self.acknowledged = false;
+        }
+    }
+    pub fn invalidate_lock_epoch(&mut self, epoch: Option<u64>) {
+        if self
+            .version
+            .is_some_and(|version| version.lock_epoch != epoch)
+        {
+            self.invalidate();
+        }
+    }
+    pub fn request(&mut self, version: SceneVersion) -> Option<String> {
+        if self.finished
+            || self.version.is_some_and(|snapshot| {
+                snapshot.lock_epoch == version.lock_epoch && version.metadata >= snapshot.metadata
+            })
+        {
+            return None;
+        }
+        self.revision = self
+            .revision
+            .checked_add(1)
+            .expect("scene recovery revision exhausted");
+        self.layout_baseline = self.layout_epoch;
+        self.version = Some(version);
+        self.acknowledged = false;
+        Some(format!(
+            "DENIAL_RECOVERY:{}:{}:{}:{}",
+            self.generation,
+            self.revision,
+            version.metadata,
+            version.lock_epoch.unwrap_or(0)
+        ))
+    }
+    pub fn acknowledge(&mut self, data: &[u8], current: SceneVersion) -> bool {
+        let Some(snapshot) = self.version else {
+            return false;
+        };
+        if data.len() > 110
+            || self.finished
+            || snapshot.lock_epoch != current.lock_epoch
+            || current.metadata < snapshot.metadata
+        {
+            return false;
+        }
+        let Ok(text) = std::str::from_utf8(data) else {
+            return false;
+        };
+        let mut parts = text.split(':');
+        if parts.next() != Some("DENIAL_RECOVERY") {
+            return false;
+        }
+        let values: Option<Vec<u64>> = parts
+            .map(|p| {
+                (!p.is_empty() && p.bytes().all(|c| c.is_ascii_digit()))
+                    .then(|| p.parse().ok())
+                    .flatten()
+            })
+            .collect();
+        if values.as_deref()
+            != Some(&[
+                self.generation,
+                self.revision,
+                snapshot.metadata,
+                snapshot.lock_epoch.unwrap_or(0),
+            ])
+        {
+            return false;
+        }
+        self.acknowledged = true;
+        true
+    }
+    pub fn note_layout(&mut self, epoch: u64) {
+        self.layout_epoch = self.layout_epoch.max(epoch);
+    }
+    pub fn render_token(&self) -> u64 {
+        if self.acknowledged && self.version.is_some() && self.layout_epoch > self.layout_baseline {
+            self.revision
+        } else {
+            0
+        }
+    }
+    pub fn permits(&self, token: u64) -> bool {
+        self.finished || (token != 0 && token == self.render_token())
+    }
+    pub fn finish(&mut self, token: u64) -> bool {
+        if !self.permits(token) {
+            return false;
+        }
+        self.finished = true;
+        true
+    }
