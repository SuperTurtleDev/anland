+//! Desktop services and Flutter callback processing shared by display backends.
+use super::*;
+#[cfg(feature = "external-output")]
+#[path = "flutter_desktop/session.rs"]
+mod session;
+#[cfg(feature = "external-output")]
+pub(crate) use session::Startup;
+use smithay::reexports::calloop::channel::{Event as ChannelEvent, channel};
+
+pub(super) fn install_runtime_events(
+    event_loop: &mut EventLoop<'_, RuntimeState>,
+) -> Result<Sender<flutter_runtime::RuntimeEvent>, Box<dyn Error>> {
+    let (sender, source) = channel();
+    event_loop.handle().insert_source(
+        source,
+        |event, _, state: &mut RuntimeState| match event {
+            ChannelEvent::Msg(flutter_runtime::RuntimeEvent::SampledBuffersReady {
+                fence,
+                batch,
+            }) => {
+                state.sampled_buffer_releases.push((fence, batch));
+            }
+            ChannelEvent::Msg(event) => state.flutter_events.push(event),
+            ChannelEvent::Closed => state.flutter_channel_closed = true,
+        },
+    )?;
+    Ok(sender)
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn initialize(
+    event_loop: &mut EventLoop<'_, RuntimeState>,
+    runtime: &flutter_runtime::FlutterRuntime,
+    wayland: Option<wayland_frontend::WaylandFrontend>,
+    desktop_size: PixelSize,
+    gamma_control: Arc<Mutex<gamma_control::GammaController>>,
+    output_control: Option<output_control::OutputControlPublisher>,
+    portal_ipc: Option<portal_ipc::PortalIpcPublisher>,
+) -> Result<RuntimeState, Box<dyn Error>> {
+    let system_controls = wayland
+        .as_ref()
+        .map(|_| SystemControls::new())
+        .transpose()?;
+    let notification_server = start_notification_server(event_loop)?;
+    let authentication = Some(runtime.authentication());
+    let clipboard = runtime.clipboard();
+    let native_escape_shortcut = wayland
+        .as_ref()
+        .map(|frontend| frontend.shortcuts.engine())
+        .unwrap_or_default();
+    let initial_theme_snapshot = portal_ipc.as_ref().map(|publisher| publisher.snapshot());
+    let initial_settings_document_revision = output_control
+        .as_ref()
+        .map(|publisher| publisher.settings_document_revision());
+    let mut events = RuntimeState {
+        wayland,
+        gamma_control,
+        native_escape_shortcut,
+        clipboard,
+        system_controls,
+        notification_server,
+        portal_ipc,
+        published_theme_snapshot: initial_theme_snapshot,
+        published_settings_document_revision: initial_settings_document_revision,
+        resolved_theme_accent: initial_theme_snapshot
+            .map_or_else(DesktopAccentColor::default, |snapshot| {
+                snapshot.accent_color
+            }),
+        authentication,
+        flutter_active: true,
+        flutter_input: flutter_runtime::InputQueue::new(desktop_size),
+        output_control,
+        ..RuntimeState::default()
+    };
+    events.text_prediction = flutter_event_loop::start_text_prediction(event_loop)?;
+    synchronize_fingerprint_unlock(&events);
+    if let Some(settings_path) = events
+        .wayland
+        .as_ref()
+        .map(|frontend| frontend.settings.path().to_path_buf())
+        && let Err(error) = settings_watch::install(&event_loop.handle(), &settings_path)
+    {
+        warn!(%error, path = %settings_path.display(), "could not watch Denial settings for external edits");
+    }
+    Ok(events)
+}
+
+fn start_notification_server(
+    event_loop: &mut EventLoop<'_, RuntimeState>,
+) -> Result<Option<NotificationServer>, Box<dyn Error>> {
+    let notification_events = Arc::new(Mutex::new(VecDeque::with_capacity(
+        NOTIFICATION_EVENT_QUEUE_CAPACITY,
+    )));
+    let notification_publish_queue = Arc::clone(&notification_events);
+    let (notification_sender, notification_source) = channel();
+    match NotificationServer::start(move |event, _| {
+        let should_wake = {
+            let mut queue = notification_publish_queue
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            let should_wake = queue.is_empty();
+            if queue.len() == NOTIFICATION_EVENT_QUEUE_CAPACITY {
+                queue.pop_front();
+            }
+            queue.push_back(event);
+            should_wake
+        };
+        if should_wake {
+            // One calloop message wakes the compositor for the complete
+            // coalesced batch; the notification worker never busy-waits.
+            let _ = notification_sender.send(());
+        }
+    }) {
+        Ok(server) => {
+            let notification_dispatch_queue = Arc::clone(&notification_events);
+            event_loop.handle().insert_source(
+                notification_source,
+                move |event, _, state: &mut RuntimeState| {
+                    if let ChannelEvent::Msg(()) = event {
+                        let mut queue = notification_dispatch_queue
+                            .lock()
+                            .unwrap_or_else(std::sync::PoisonError::into_inner);
+                        state.pending_notification_events.extend(queue.drain(..));
+                    }
+                },
+            )?;
+            Ok(Some(server))
+        }
+        Err(error) => {
+            error!(%error, "Denial could not start its notification service");
+            Ok(None)
+        }
+    }
+}
+
+pub(super) fn process_flutter_event_batch(
+    runtime: &mut flutter_runtime::FlutterRuntime,
+    events: &mut RuntimeState,
+) -> Result<(), Box<dyn Error>> {
+    if events.flutter_input.has_pending() {
+        runtime.process_input_batch(&mut events.flutter_input)?;
+    }
+    // Drain in place so the callback queue retains its allocation across the
+    // steady-state AwaitVSync and platform-task hot path.
+    let event_count = events
+        .flutter_events
+        .len()
+        .min(MAX_FLUTTER_EVENTS_PER_ITERATION);
+    runtime.process_events(events.flutter_events.drain(..event_count))?;
+    if runtime.take_native_window_fallback() {
+        events.scene_sync.mark_dirty();
+    }
+    synchronize_authentication_boundary(events);
+    synchronize_flutter_window_commands(runtime, events)?;
+    Ok(())
+}
+
+pub(super) fn synchronize_periodic_shell_services(
+    runtime: &mut flutter_runtime::FlutterRuntime,
+    events: &mut RuntimeState,
+) -> Result<(), Box<dyn Error>> {
+    synchronize_clipboard(runtime, events)?;
+    synchronize_system_control_events(runtime, events)?;
+    synchronize_notification_events(runtime, events)?;
+    synchronize_xembed_tray(runtime, events)?;
+    synchronize_shell_keyboard(runtime, events)?;
+    synchronize_settings(runtime, events)?;
+    Ok(())
+}
+
+/// Shared desktop applications; callers enforce diagnostic and readiness gates.
+pub(super) fn start_startup_applications(
+    runtime: &flutter_runtime::FlutterRuntime,
+    polkit_agent: bool,
+    systemd_started: bool,
+    plugin_rebuild_needed: bool,
+) {
+    if !systemd_started
+        && polkit_agent
+        && std::env::var("DENIAL_POLKIT_AGENT").as_deref() != Ok("0")
+    {
+        let binary =
+            std::env::var("DENIAL_POLKIT_BINARY").unwrap_or_else(|_| "denial-polkit-agent".into());
+        if let Err(error) =
+            runtime.start_startup_application(vec![binary], "dev.denial.Polkit.desktop")
+        {
+            warn!(%error, "could not start authentication agent");
+        }
+    }
+    if let Some(arguments) = crate::welcome::launch_arguments()
+        && let Err(error) =
+            runtime.start_startup_application(arguments, "dev.denial.Welcome.desktop")
+    {
+        warn!(%error, "could not start Welcome");
+    }
+    if plugin_rebuild_needed {
+        if let Some(arguments) = crate::plugin_bundle::resume_arguments() {
+            if let Err(error) =
+                runtime.start_startup_application(arguments, "dev.denial.PluginManager.desktop")
+            {
+                warn!(%error, "could not resume the plugin rebuild");
+            }
+        } else {
+            info!(
+                "plugins need a rebuild for this Denial version; the plugin manager is not installed"
+            );
+        }
+    }
+}
