+//! Activate desktop services only after the display backend reports its readiness boundary.
+//! Reuse upstream session/application APIs; no service lifecycle during checks,
+//! bounded diagnostics or --wm-only, and no repeated onboarding on reconnect.
+use crate::flutter_launcher::FlutterLauncher;
+use crate::flutter_runtime::FlutterRuntime;
+use crate::options::RuntimeLimit;
+use crate::session_activation::SystemdEnvironmentRestore;
+use crate::wayland_frontend::WaylandFrontend;
+use std::path::Path;
+use tracing::warn;
+
+pub(crate) struct Startup {
+    enabled: bool,
+    activated: bool,
+    systemd_restore: Option<SystemdEnvironmentRestore>,
+    polkit_agent: bool,
+}
+
+impl Startup {
+    pub fn new(limit: RuntimeLimit, polkit_agent: bool, desktop_enabled: bool) -> Self {
+        Self {
+            enabled: limit == RuntimeLimit::UntilLogout && desktop_enabled,
+            activated: false,
+            systemd_restore: None,
+            polkit_agent,
+        }
+    }
+
+    fn claim_ready(&mut self, ready: bool) -> bool {
+        if !self.enabled || self.activated || !ready {
+            return false;
+        }
+        self.activated = true;
+        true
+    }
+
+    pub fn activate(
+        &mut self,
+        ready: bool,
+        runtime: &FlutterRuntime,
+        frontend: &WaylandFrontend,
+        control_socket: Option<&Path>,
+        launcher: &FlutterLauncher,
+    ) {
+        if !self.claim_ready(ready) {
+            return;
+        }
+        match crate::publish_session_activation_environment(
+            frontend.socket_name(),
+            frontend.xdisplay_name().as_deref(),
+            control_socket.map(Path::as_os_str),
+            self.polkit_agent,
+        ) {
+            Ok(activation) => self.systemd_restore = activation.into_systemd_restore(),
+            Err(error) => warn!(%error, "could not activate the desktop session environment"),
+        }
+        super::start_startup_applications(
+            runtime,
+            self.polkit_agent,
+            self.systemd_restore.is_some(),
+            launcher.plugin_rebuild_needed(),
+        );
+    }
+
+    pub fn stop(&mut self) {
+        if let Some(restore) = self.systemd_restore.take() {
+            if let Err(error) = crate::stop_systemd_graphical_session(&restore) {
+                warn!(%error, "could not retire the desktop graphical-session target");
+            }
+        }
+    }
+}
